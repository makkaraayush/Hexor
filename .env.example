# Hexor Assistant Environment Configuration Template
# Copy this file to backend/.env and populate your values.

# Server Configuration
HEXOR_HOST=127.0.0.1
HEXOR_PORT=8000

# LLM Providers (Pick one or configure both for fallback)
# Free Groq key: https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Free Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Local Offline LLM via Ollama (Optional)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Voice & Neural TTS Settings
VOICE_NAME=en-GB-RyanNeural
VOICE_RATE=+0%
VOICE_PITCH=-4Hz
USER_TITLE=Sir

# Spotify Web API (Optional: The built-in Spicetify bridge works without these)
# Developer Portal: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/spotify/callback

# Bambu Lab A1 3D Printer LAN Mode (Optional)
# Found under: Printer Settings -> Network -> LAN Mode
BAMBU_IP=
BAMBU_SERIAL=
BAMBU_ACCESS_CODE=

# Geo Location & Weather (Optional fallback coordinates)
DEFAULT_LOCATION=
DEFAULT_LATITUDE=
DEFAULT_LONGITUDE=
